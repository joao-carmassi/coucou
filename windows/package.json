{
  "name": "coucou-windows",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/catalog.test.ts tests/resolvers.test.ts tests/timer.test.ts tests/upload.test.ts tests/providers.test.ts",
    "test:harness": "vitest run --config vitest.config.ts",
    "icons": "node scripts/gen-icons.mjs",
    "idle-audit": "node scripts/idle-audit.mjs",
    "neutrality-audit": "node scripts/neutrality-audit.mjs",
    "check": "tsc --noEmit && npm test && npm run test:harness && npm run idle-audit && npm run neutrality-audit",
    "tauri": "tauri",
    "predev": "cargo build --release -p coucou-hook",
    "prebuild": "cargo build --release -p coucou-hook",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "happy-dom": "20.14.5",
    "typescript": "^5.6.0",
    "vite": "^6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1"
  }
}
